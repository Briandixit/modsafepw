NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string from your host/provider.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Use a long random value, at least 48 characters.
SESSION_SECRET=replace-with-long-random-secret

# Optional extra pepper for API-key hashes. If omitted, SESSION_SECRET is used.
API_KEY_PEPPER=replace-with-different-long-random-secret

# Comma-separated browser origins that may call the API.
# Example: https://modsafe.example.com,https://www.modsafe.example.com
CORS_ORIGIN=https://your-domain.com

# Moderation providers.
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
HF_TOKEN=replace-with-huggingface-token

# Admin login. Generate with:
# npm run hash:admin -- "YourLongAdminPassword1!"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-pbkdf2-password-hash

LOG_LEVEL=info
